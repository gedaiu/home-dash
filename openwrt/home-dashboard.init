#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/node
APP_DIR=/opt/home-dashboard
CONFIG_FILE=/etc/home-dashboard/config.json
DATA_DIR=/var/home-dashboard/data

start_service() {
    procd_open_instance
    procd_set_param command $PROG $APP_DIR/src/server.js
    procd_set_param respawn 60 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/home-dashboard.pid
    procd_set_param env NODE_ENV=production
    procd_set_param env HOME_DASHBOARD_CONFIG=$CONFIG_FILE
    procd_set_param env HOME_DASHBOARD_DATA=$DATA_DIR
    procd_close_instance
}

stop_service() {
    service_stop $PROG
}

reload_service() {
    stop
    start
}
